#!/bin/sh
# Unix launcher for herdr_secret.py (Windows uses herdr-secret.cmd). Follows symlinks.
self="$0"
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case "$link" in /*) self="$link" ;; *) self="$(dirname "$self")/$link" ;; esac
done
exec python3 -I "$(dirname "$self")/herdr_secret.py" "$@"
